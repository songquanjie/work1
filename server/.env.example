PORT=3000

# none | dashscope
# none fails immediately with a readable error (no fake transcript).
ASR_PROVIDER=none

# none | dashscope
LLM_PROVIDER=none

# Beijing DashScope. Do not commit the real key. Workspace ID is optional.
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_ASR_MODEL=qwen3-asr-flash
DASHSCOPE_LLM_MODEL=qwen-plus
